# Ed25519 secret key (base64) the gate signs edit-admission UCANs with. Unset ⇒ edit UCANs disabled.
GATE_SIGNING_KEY=
# DID of the collaboration-server (the audience of minted edit UCANs).
COLLAB_SERVER_DID=

# Vault: per-identity VOPRF key for the client key vault (base64, 32 bytes; scripts/generateVaultKey.ts)
GATE_VAULT_KEY=
# Bump on rotation and move the old key to GATE_VAULT_KEY_PREVIOUS for a 30-day window
GATE_VAULT_KEY_VERSION=1
GATE_VAULT_KEY_PREVIOUS=
# Exact origins allowed to call /vault with credentials, comma-separated
VAULT_ALLOWED_ORIGINS=https://docs.fileverse.io,http://localhost:3000
